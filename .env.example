# =============================================================================
# MindFrame — Environment Variables
# Copy to .env, fill in your keys, deploy.
# =============================================================================

# Stripe (payments) — https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_live_your-key-here
STRIPE_SECRET_KEY=sk_live_your-key-here

# OpenAI (script generation) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# ElevenLabs (AI voiceovers) — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_your-key-here

# ConvertKit (email marketing) — https://app.convertkit.com/account_settings/advanced_settings
CONVERTKIT_API_KEY=your-key-here
CONVERTKIT_API_SECRET=your-secret-here

# Gumroad (digital products) — https://app.gumroad.com/settings/advanced
GUMROAD_ACCESS_TOKEN=your-token-here
